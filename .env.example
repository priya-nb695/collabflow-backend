NODE_ENV=development
PORT=4000
# Local:  mongodb://127.0.0.1:27017/collabflow
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/collabflow
MONGODB_URI=mongodb://127.0.0.1:27017/collabflow
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Your React app origin(s), comma separated
CLIENT_URL=http://localhost:3000
